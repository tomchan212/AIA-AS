# ============================================================
# 專用寄信 Gmail 設定（建議：aia-booking@gmail.com）
# ============================================================
#
# 【第一步】開新 Gmail 帳戶（專用寄信，唔好同個人 Gmail 混用）
#   建議地址：aia-booking@gmail.com（或類似名稱）
#
# 【第二步】在新帳戶開啟「兩步驗證」
#   https://myaccount.google.com/security
#
# 【第三步】建立「應用程式密碼」（16 位）
#   同一頁 → 應用程式密碼 → 選「郵件 / 其他」
#
# 【第四步】把 App Password 設為 Firebase Secret（唔好 commit）：
#   firebase functions:secrets:set SMTP_PASS
#
# 【第五步】本地測試：
#   cd functions
#   SMTP_PASS=你的16位密碼 node send-test-email.js
#
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 專用寄信帳戶（寄件人）
SMTP_USER=aia-booking@gmail.com

# 你的個人 email（收到新預約通知）
NOTIFY_TO=waiwaichan212@gmail.com

# 客戶收到信時顯示的寄件人名稱
NOTIFY_FROM=AIA 預約系統 <aia-booking@gmail.com>

# 本地測試用（正式環境請用 firebase functions:secrets:set SMTP_PASS）
# SMTP_PASS=
